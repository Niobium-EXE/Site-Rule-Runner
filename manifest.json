{
  "manifest_version": 3,
  "name": "Site Rule Runner",
  "version": "1.0.0",
  "description": "Hide elements by CSS selector and run your own JavaScript on selected websites.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Site Rule Runner",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
