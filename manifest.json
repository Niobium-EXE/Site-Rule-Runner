{
  "manifest_version": 3,
  "name": "Site Rule Runner",
  "version": "1.2.0",
  "description": "Hide page elements with CSS selectors and run site-specific JavaScript rules.",
  "permissions": [
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Site Rule Runner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png",
      "48": "icons/inactive-48.png",
      "128": "icons/inactive-128.png"
    }
  },
  "icons": {
    "16": "icons/inactive-16.png",
    "32": "icons/inactive-32.png",
    "48": "icons/inactive-48.png",
    "128": "icons/inactive-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
