{
  "manifest_version": 3,
  "name": "Site Rule Runner",
  "version": "1.1.0",
  "description": "Hide elements by CSS selector and run your own JavaScript on selected websites.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "action": {
    "default_title": "Site Rule Runner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png",
      "48": "icons/inactive-48.png",
      "128": "icons/inactive-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
